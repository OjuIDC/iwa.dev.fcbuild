FROM python:3.11.16-slim@sha256:e41613d42d4891e4930f79523f93f81bbc7632584ec65e36ab055f41a800b41e

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    FC27_DISCORD_BOT_ENABLED=false \
    FC27_COMMUNITY_POLLING_ENABLED=false \
    FC27_COMMUNITY_PROVIDER_ENABLED=false \
    FC27_RECOMMENDATIONS_ENABLED=false \
    DISPATCH_ENABLED=false

WORKDIR /app

RUN useradd -r -u 10001 -g nogroup app \
 && pip install --no-cache-dir \
    "pydantic>=2.8,<3" \
    "psycopg[binary]>=3.2,<4" \
    "discord.py==2.7.1" \
    "pandas>=2.0,<3" \
    "openpyxl>=3.1,<4"

COPY src /app/src
COPY scripts/fc27_discord_bot.py /app/scripts/

USER 10001:65534

HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
  CMD ["python", "scripts/fc27_discord_bot.py", "--status"]

ENTRYPOINT ["python", "scripts/fc27_discord_bot.py"]
CMD ["--status"]
