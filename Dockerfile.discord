FROM python:3.11.18-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    FC27_DISCORD_BOT_ENABLED=false \
    FC27_COMMUNITY_POLLING_ENABLED=false \
    FC27_COMMUNITY_PROVIDER_ENABLED=false \
    FC27_RECOMMENDATIONS_ENABLED=false \
    DISPATCH_ENABLED=false

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade zlib1g \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -r -u 10001 -g nogroup app \
 && pip install --no-cache-dir --upgrade \
    "setuptools>=84.2.1" \
    "wheel>=0.48.0" \
 && pip install --no-cache-dir \
    "pydantic>=2.8,<3" \
    "psycopg[binary]>=3.2,<4" \
    "discord.py==2.7.1" \
    "pandas>=2.0,<3" \
    "openpyxl>=3.1,<4"

COPY src /app/src
COPY scripts /app/scripts

USER 10001:65534

HEALTHCHECK --interval=30s --timeout=12s --retries=3 --start-period=90s \
  CMD ["python", "scripts/fc27_discord_healthcheck.py"]

ENTRYPOINT ["python", "scripts/fc27_discord_bot.py"]
CMD ["--status"]
