FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg tesseract-ocr curl && rm -rf /var/lib/apt/lists/* && useradd -r -u 10001 app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY src /app/src
COPY config /app/config
USER app
EXPOSE 8001 8765 8766
CMD ["uvicorn","src.graph_api:app","--host","0.0.0.0","--port","8001"]
