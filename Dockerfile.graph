FROM python:3.11.16-slim@sha256:e41613d42d4891e4930f79523f93f81bbc7632584ec65e36ab055f41a800b41e
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg tesseract-ocr curl && rm -rf /var/lib/apt/lists/* && useradd -r -u 10001 app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY src /app/src
COPY config /app/config
COPY migrations /app/migrations
USER app
EXPOSE 8001 8765 8766
CMD ["uvicorn","src.graph_api:app","--host","0.0.0.0","--port","8001"]
