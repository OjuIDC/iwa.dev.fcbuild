FROM python:3.15.0rc3-slim@sha256:a3af3d230522dd52f7f2191b39e1892912dbcb0c8dee22afdec3dc83baf0f549
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg tesseract-ocr curl && rm -rf /var/lib/apt/lists/* && useradd -r -u 10001 app
COPY requirements.txt requirements-swarms.txt requirements-langfuse.txt /app/
ARG WITH_SWARMS=false
ARG WITH_LANGFUSE=false
RUN pip install --no-cache-dir -r requirements.txt \
 && if [ "$WITH_SWARMS" = "true" ]; then pip install --no-cache-dir -r requirements-swarms.txt; fi \
 && if [ "$WITH_LANGFUSE" = "true" ]; then pip install --no-cache-dir -r requirements-langfuse.txt; fi
ENV SWARMS_TELEMETRY_ON=false
COPY src /app/src
COPY config /app/config
COPY migrations /app/migrations
USER app
EXPOSE 8001 8765 8766
CMD ["uvicorn","src.graph_api:create_app","--factory","--host","0.0.0.0","--port","8001"]
