{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://east-coasters.local/schemas/fc27_east_coasters_normalized_export.schema.json",
  "title": "East Coasters FC 27 Operator-Captured Normalized Export Schema",
  "description": "Strict JSON Schema for operator-captured displayed data for East Coasters (Club ID 330323, common-gen5, FC27). Excludes cookies, sessions, tokens, HTTP headers, raw browser responses, EA account/persona/nucleus IDs, external player IDs, and gamer tags.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "export_id",
    "contract_version",
    "schema_version",
    "formula_version",
    "generated_at",
    "supplied_at",
    "provider",
    "game_version",
    "platform",
    "club",
    "supplier_attestation",
    "consent_attestation",
    "operator_capture_attestation",
    "matches",
    "source_classification",
    "payload_sha256"
  ],
  "properties": {
    "export_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "formula_version": {
      "const": "fc27-v1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 40
    },
    "supplied_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 40
    },
    "provider": {
      "const": "EA_FC_PRO_CLUBS"
    },
    "game_version": {
      "const": "FC27"
    },
    "platform": {
      "const": "common-gen5"
    },
    "club": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "club_id",
        "club_name",
        "platform",
        "game_version"
      ],
      "properties": {
        "club_id": {
          "const": "330323"
        },
        "club_name": {
          "const": "East Coasters"
        },
        "platform": {
          "const": "common-gen5"
        },
        "game_version": {
          "const": "FC27"
        },
        "supplied_identity_state": {
          "type": "string",
          "enum": ["PROVISIONAL"]
        },
        "source_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "club_statistics": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "matches_played",
        "wins",
        "draws",
        "losses",
        "goals_for",
        "goals_against"
      ],
      "properties": {
        "matches_played": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "wins": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "draws": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "losses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "goals_for": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "goals_against": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "clean_sheets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "skill_rating": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 5000
        },
        "reputation_tier": {
          "type": ["string", "null"],
          "maxLength": 64
        }
      }
    },
    "supplier_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplier_role",
        "supplier_reference",
        "attested_at",
        "authority_scope",
        "statement_version"
      ],
      "properties": {
        "supplier_role": {
          "type": "string",
          "enum": ["CLUB_MANAGER", "CLUB_ADMIN", "DATA_STEWARD"]
        },
        "supplier_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attested_at": {
          "type": "string",
          "format": "date-time",
          "minLength": 20,
          "maxLength": 40
        },
        "authority_scope": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "CLUB_IDENTITY",
              "MATCH_RESULTS",
              "LINEUPS",
              "PLAYER_PERFORMANCE",
              "BUILD_REFERENCES"
            ]
          }
        },
        "statement_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "consent_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consent_version",
        "consented_at",
        "data_categories",
        "retention_acknowledged",
        "analytics_use_acknowledged",
        "team_review_acknowledged"
      ],
      "properties": {
        "consent_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "consented_at": {
          "type": "string",
          "format": "date-time",
          "minLength": 20,
          "maxLength": 40
        },
        "data_categories": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "CLUB_IDENTITY",
              "MATCH_RESULTS",
              "LINEUPS",
              "PLAYER_PERFORMANCE",
              "BUILD_REFERENCES"
            ]
          }
        },
        "retention_acknowledged": {
          "const": true
        },
        "analytics_use_acknowledged": {
          "const": true
        },
        "team_review_acknowledged": {
          "const": true
        },
        "revoked_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "operator_capture_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_reference",
        "operator_authority_status",
        "member_consent_status",
        "captain_consent_status",
        "manager_authority_database_status",
        "allowed_purpose",
        "publication_allowed",
        "recommendations_allowed",
        "dispatch_allowed"
      ],
      "properties": {
        "attestation_reference": {
          "const": "api-east-coasters-authority-2026-10"
        },
        "operator_authority_status": {
          "const": "USER_ATTESTED"
        },
        "member_consent_status": {
          "const": "USER_ATTESTED"
        },
        "captain_consent_status": {
          "const": "USER_ATTESTED"
        },
        "manager_authority_database_status": {
          "const": "UNVERIFIED"
        },
        "allowed_purpose": {
          "const": "TEAM_REVIEW"
        },
        "publication_allowed": {
          "const": false
        },
        "recommendations_allowed": {
          "const": false
        },
        "dispatch_allowed": {
          "const": false
        }
      }
    },
    "matches": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external_match_id",
          "played_at",
          "match_type",
          "match_status",
          "result",
          "goals_for",
          "goals_against",
          "opponent_name",
          "formation",
          "data_quality_status",
          "source_classification"
        ],
        "properties": {
          "external_match_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "played_at": {
            "type": "string",
            "format": "date-time",
            "minLength": 20,
            "maxLength": 40
          },
          "match_type": {
            "type": "string",
            "enum": ["LEAGUE", "PLAYOFF", "FRIENDLY", "CUP", "PRACTICE", "UNKNOWN"]
          },
          "match_status": {
            "type": "string",
            "enum": ["COMPLETED", "ABANDONED", "PARTIAL"]
          },
          "result": {
            "type": "string",
            "enum": ["WIN", "LOSS", "DRAW"]
          },
          "goals_for": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "goals_against": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "opponent_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "formation": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 32
          },
          "data_quality_status": {
            "type": "string",
            "enum": ["PROVISIONAL", "INCOMPLETE"]
          },
          "source_classification": {
            "const": "OPERATOR_CAPTURED_DISPLAYED_DATA"
          },
          "lineup": {
            "type": "array",
            "maxItems": 11,
            "items": {
              "type": "string",
              "pattern": "^plr_ecf_[a-z0-9_]{3,48}$"
            }
          },
          "player_performances": {
            "type": "array",
            "maxItems": 18,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "local_player_reference",
                "position",
                "role",
                "goals",
                "assists"
              ],
              "properties": {
                "local_player_reference": {
                  "type": "string",
                  "pattern": "^plr_ecf_[a-z0-9_]{3,48}$"
                },
                "display_alias": {
                  "type": "null"
                },
                "position": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8
                },
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "minutes_played": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 130
                },
                "goals": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99
                },
                "assists": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99
                },
                "passes_attempted": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 500
                },
                "passes_completed": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 500
                },
                "tackles_attempted": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 200
                },
                "tackles_won": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 200
                },
                "interceptions": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 200
                },
                "shots": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 100
                },
                "shots_on_target": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 100
                },
                "saves": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 100
                },
                "possession_losses": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 200
                },
                "provider_rating": {
                  "type": ["number", "null"],
                  "minimum": 0.0,
                  "maximum": 10.0
                },
                "clean_sheet": {
                  "type": ["boolean", "null"]
                },
                "build_reference": {
                  "type": ["string", "null"],
                  "maxLength": 64
                }
              }
            }
          },
          "source_record_hash": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "source_classification": {
      "const": "OPERATOR_CAPTURED_DISPLAYED_DATA"
    },
    "data_classification": {
      "type": "string",
      "enum": ["SYNTHETIC", "OPERATOR_PRIVATE"]
    },
    "real_player_data": {
      "type": "boolean"
    },
    "safe_for_tests": {
      "type": "boolean"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
