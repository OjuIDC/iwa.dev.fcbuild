{
  "policy_version": "fc27-documentation-consistency-v1",
  "bounds": {
    "max_file_bytes": 2097152,
    "max_markdown_files": 2000,
    "max_references_per_file": 10000,
    "max_policy_depth": 32,
    "max_results": 20000,
    "max_json_output_bytes": 10485760,
    "max_execution_seconds": 30
  },
  "current_document_roots": [
    "README.md",
    "MIGRATION_GUIDE.md",
    "TEST_RESULTS.md",
    "THIRD_PARTY_NOTICES.md",
    "scripts/README.md",
    "docs"
  ],
  "excluded_prefixes": [
    ".git/",
    ".local-artifacts/",
    ".local-data/",
    "secrets/",
    "node_modules/",
    ".venv/",
    "venv/",
    "__pycache__/",
    ".pytest_cache/",
    "htmlcov/",
    "docs/claude/",
    "docs/superpowers/"
  ],
  "archive_prefix": "docs/archive/",
  "scripts_archive_prefix": "scripts/archive/",
  "archive_manifest_json": "config/fc27_archive_manifest.json",
  "removed_items_manifest_json": "config/fc27_removed_items_manifest.json",
