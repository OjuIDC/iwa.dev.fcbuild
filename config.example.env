# FC27 stack configuration template. Copy to .env and replace EVERY placeholder.
# Generate each secret separately, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
# Never commit .env. Never reuse a value for two variables.

FC27_CLUB_ID=330323
FC_PLATFORM=common-gen5

# --- Datastores -------------------------------------------------------------
POSTGRES_PASSWORD=replace_with_long_random_password
REDIS_PASSWORD=replace_with_long_random_password

# --- Graph API credentials (see docs/APPROVAL_SECURITY.md) -------------------
# Service role: start runs and read thread state. Given to live-watcher and
# voice-gateway. It can NEVER approve or reject.
GRAPH_SERVICE_TOKEN=replace_with_64_hex_characters
# Commissioner role: the human approver's token. Keep the plaintext OUT of .env
# (store it in a password manager). Put only its SHA-256 here:
#   python scripts/commissioner_decide.py hash-token
GRAPH_COMMISSIONER_TOKEN_SHA256=replace_with_sha256_hex_of_commissioner_token
# Identity recorded as approved_by for decisions made with the commissioner token.
COMMISSIONER_ID=batmanL8
# HMAC key the Commissioner uses to sign each decision. Only graph-api and the
# Commissioner's own workstation hold it.
APPROVAL_SIGNING_SECRET=replace_with_64_hex_characters
APPROVAL_TTL_SECONDS=120

# --- Internal service credentials --------------------------------------------
MCP_API_TOKEN=replace_with_64_hex_characters
WS_AUTH_TOKEN=replace_with_64_hex_characters
WS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
VOICE_API_TOKEN=replace_with_64_hex_characters

# --- Models -----------------------------------------------------------------
REQUIRED_MODELS=llama3.2:3b qwen2.5:7b
# Images are pinned by tag and digest in docker-compose.yml. Override only with
# another tag@digest you have validated.
#OLLAMA_IMAGE=ollama/ollama:0.34.4@sha256:...
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_QUEUE=64
OLLAMA_KEEP_ALIVE=10m
CUDA_VISIBLE_DEVICES=0
OLLAMA_GPUS=all
# LM Studio fallback: false (default) means no LM Studio request is ever made.
LM_STUDIO_FALLBACK_ENABLED=false
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1

# --- Watchers and capture -----------------------------------------------------
POLL_INTERVAL_SEC=30
TILT_THRESHOLD=3
XBOX_IP=

# --- Host ports (always bound to 127.0.0.1) -----------------------------------
GRAPH_HOST_PORT=8001
WS_HOST_PORT=8765
WS_HEALTH_HOST_PORT=8766
REDIS_HOST_PORT=6379
VOICE_HOST_PORT=9000
MCP_ALLOWED_ORIGIN=http://localhost

# --- Voice profile ------------------------------------------------------------
STT_MODEL=small.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_GPUS=all
STT_GPU_COMPUTE_TYPE=float16
