# FC27 stack configuration template. Copy to .env and replace EVERY placeholder.
# Generate each secret separately, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
# Never commit .env. Never reuse a value for two variables.

FC27_CLUB_ID=330323
FC_PLATFORM=common-gen5

# --- Datastores -------------------------------------------------------------
# POSTGRES_PASSWORD is used only for the postgres container engine initialization.
# Application database roles and URIs are mounted from ./secrets/ (see MIGRATION_GUIDE.md):
#   ./secrets/postgres_admin_uri
#   ./secrets/fc27_migrator_password
#   ./secrets/fc27_app_password
#   ./secrets/fc27_dispatch_password
#   ./secrets/fc27_migrator_uri
#   ./secrets/fc27_app_uri
# Never put application database passwords or connection URIs in .env.
POSTGRES_PASSWORD=replace_with_long_random_password
REDIS_PASSWORD=replace_with_long_random_password

# --- Graph API credentials (see docs/APPROVAL_SECURITY.md) -------------------
# Service role: start runs and read thread state. It can NEVER approve or reject.
GRAPH_SERVICE_TOKEN=replace_with_64_hex_characters
# Commissioner role: the human approver's token. Keep the plaintext OUT of .env
# (store it in a password manager). Put only its SHA-256 here:
#   python scripts/commissioner_decide.py hash-token
GRAPH_COMMISSIONER_TOKEN_SHA256=replace_with_sha256_hex_of_commissioner_token
# Identity recorded as approved_by for decisions made with the commissioner token.
COMMISSIONER_ID=batmanL8
# HMAC key the Commissioner uses to sign each decision. Only graph-api and the
# Commissioner's own workstation hold it.
APPROVAL_SIGNING_SECRET=replace_with_64_hex_characters
APPROVAL_TTL_SECONDS=120

# --- Phase 2 Identity secrets (file-based, mounted into graph-api ONLY) ------
# BFF_SERVICE_TOKEN authenticates the BFF gateway; must differ from GRAPH_SERVICE_TOKEN.
# Provided via file secret: ./secrets/bff_service_token (44+ chars, high entropy)
# BFF_SERVICE_TOKEN=replace_with_64_hex_characters
# Fernet key (44-char urlsafe base64, 32 bytes) for TOTP seed encryption at rest.
# Provided via file secret: ./secrets/identity_encryption_key
# IDENTITY_ENCRYPTION_KEY=replace_with_44_char_urlsafe_base64
# One-time commissioner bootstrap secret. There is NO fallback: if absent/weak,
# bootstrap is disabled (fail closed). Provided via file secret: ./secrets/bootstrap_token
# BOOTSTRAP_TOKEN=replace_with_48_char_high_entropy_token

# --- Deployment identity (gates evaluation, C-4) ----------------------------
FC27_CODE_REVISION=
FC27_DEPLOYMENT_ID=

# --- FC 27 Persistence and Provider Feature Gates (all disabled by default) --
# FC27_PROVIDER_ENABLED controls FC 27 provider adapter execution (default: false).
FC27_PROVIDER_ENABLED=false
# FC27_LIVE_INGESTION_ENABLED controls live FC 27 API ingestion (default: false).
FC27_LIVE_INGESTION_ENABLED=false
# FC27_API_CACHE_ENABLED controls bounded in-memory normalized object caching (default: false).
# Enabling cache does NOT enable provider access.
FC27_API_CACHE_ENABLED=false
# FC27_API_RATE_LIMIT_ENABLED controls provider token-bucket rate limiting (default: false).
# Enabling rate limiting does NOT enable provider access.
FC27_API_RATE_LIMIT_ENABLED=false
# FC27_API_CIRCUIT_BREAKER_ENABLED controls circuit breaker protection (default: true).
FC27_API_CIRCUIT_BREAKER_ENABLED=true
# FC27_PERSISTENCE_ENABLED controls PostgreSQL performance storage apply operations.
# Default is false (dry-run/deferred only). Enabling persistence does NOT enable
# live provider access, recommendations, dispatch, or raw upload retention, and
# still requires explicit --apply --confirm-apply and a valid PostgreSQL connection.
FC27_PERSISTENCE_ENABLED=false
# FC27_ANALYTICS_ENABLED controls read-only PostgreSQL analytics retrieval.
# Default is false. Enabling analytics does NOT enable persistence, live
# provider access, recommendations, dispatch, or raw upload retention.
FC27_ANALYTICS_ENABLED=false
# FC27_RECOMMENDATIONS_ENABLED and DISPATCH_ENABLED remain disabled by default.
FC27_RECOMMENDATIONS_ENABLED=false
DISPATCH_ENABLED=false

# --- FC 27 Community Provider & Polling Worker Gates (disabled by default) ---
FC27_COMMUNITY_PROVIDER_ENABLED=false
FC27_COMMUNITY_POLLING_ENABLED=false
FC27_COMMUNITY_POLL_INTERVAL_SECONDS=43200
FC27_COMMUNITY_POLL_MIN_SECONDS=43200
FC27_COMMUNITY_POLL_MAX_SECONDS=43200
FC27_COMMUNITY_POLL_MAX_REQUESTS=1
FC27_COMMUNITY_POLL_MAX_RETRIES=0
FC27_COMMUNITY_POLL_ANALYTICS_ON_NEW_ONLY=true
FC27_COMMUNITY_POLL_SINGLE_FLIGHT=true
FC27_COMMUNITY_POLL_ONCE=false

# --- FC 27 Local Loopback Ingestion Demo Gates (all fail-closed by default) --
# FC27_DEMO_MODE controls local loopback demo endpoints and transport exception (default: false).
# Enabling FC27_DEMO_MODE does NOT enable provider access, live ingestion, persistence,
# global analytics, recommendations, dispatch, or continuous polling.
FC27_DEMO_MODE=false
FC27_DEMO_SOURCE=fixture
FC27_DEMO_BIND_HOST=127.0.0.1
FC27_DEMO_MAX_REQUESTS=1
FC27_DEMO_MAX_RETRIES=0
FC27_DEMO_RAW_RESPONSE_RETENTION=false
FC27_DEMO_PORT=0

# --- FC 27 Read-Only Discord Bot Gates (all fail-closed by default) -----------
# FC27_DISCORD_BOT_ENABLED controls the read-only Discord slash-command bot (default: false).
# Requires DISCORD_BOT_TOKEN_FILE (or DISCORD_BOT_TOKEN) plus non-empty numeric allowlists
# in FC27_DISCORD_ALLOWED_GUILD_IDS and FC27_DISCORD_ALLOWED_CHANNEL_IDS.
DISCORD_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_GUILD_IDS=
DISCORD_CHANNEL_IDS=
DISCORD_ROLE_IDS=
FC27_DISCORD_BOT_ENABLED=false
FC27_DISCORD_ALLOWED_GUILD_IDS=
FC27_DISCORD_ALLOWED_CHANNEL_IDS=
FC27_DISCORD_ALLOWED_ROLE_IDS=
# Explicit Discord role IDs authorized to execute manual Match Results write commands
# (/fc27 matchday, /fc27 result, /fc27 editresult, /fc27 deletematch).
# Role names are never trusted; configure numeric Discord role IDs only.
FC27_DISCORD_MANAGER_ROLE_IDS=
FC27_DISCORD_CAPTAIN_ROLE_IDS=
FC27_DISCORD_ADMIN_ROLE_IDS=
FC27_DISCORD_RESULTS_CHANNEL_ID=
# Dedicated least-privilege writer database URI file for fc27_match_results_writer
FC27_MATCH_RESULTS_WRITER_URI_FILE=
FC27_MATCH_RESULTS_WRITER_PASSWORD_FILE=
DISCORD_BOT_TOKEN_FILE=

# --- FC 27 Performance Telemetry Gate (disabled by default) -------------------
# FC27_PERFORMANCE_TELEMETRY_ENABLED controls bounded local performance telemetry writing
# to .local-artifacts/performance/ (default: false).
FC27_PERFORMANCE_TELEMETRY_ENABLED=false

# --- Host ports (always bound to 127.0.0.1) -----------------------------------
GRAPH_HOST_PORT=8001
REDIS_HOST_PORT=6379
