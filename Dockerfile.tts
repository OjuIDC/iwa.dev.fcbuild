FROM python:3.15.0rc3-slim@sha256:a3af3d230522dd52f7f2191b39e1892912dbcb0c8dee22afdec3dc83baf0f549
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends espeak-ng && rm -rf /var/lib/apt/lists/* && useradd -r -u 10001 voice && chown -R voice:voice /app
RUN pip install --no-cache-dir fastapi uvicorn[standard]
COPY --chown=voice:voice voice/tts_service.py /app/tts_service.py
USER voice
EXPOSE 9002
CMD ["uvicorn","tts_service:app","--host","0.0.0.0","--port","9002"]
